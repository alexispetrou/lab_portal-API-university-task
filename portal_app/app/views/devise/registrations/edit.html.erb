<div style="min-height: 100vh; background: #f9fafb; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif; padding: 20px;">
  <div style="max-width: 600px; margin: 0 auto;">
    
    <%# Header %>
    <div style="text-align: center; margin-bottom: 40px;">
      <div style="width: 64px; height: 64px; background: linear-gradient(135deg, #6366f1 0%, #8b5cf6 100%); border-radius: 16px; margin: 0 auto 16px; display: flex; align-items: center; justify-content: center;">
        <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2">
          <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path>
          <circle cx="12" cy="7" r="4"></circle>
        </svg>
      </div>
      <h2 style="font-size: 28px; font-weight: 800; color: #111827; margin: 0 0 8px 0;">Επεξεργασία Προφίλ</h2>
      <p style="color: #6b7280; font-size: 15px;">Ενημερώστε τα στοιχεία του λογαριασμού σας</p>
    </div>

    <%# Main Form Card %>
    <div style="background: white; border-radius: 16px; padding: 40px; border: 1px solid #e5e7eb; box-shadow: 0 10px 25px -5px rgba(0, 0, 0, 0.05); margin-bottom: 24px;">
      <%= form_for(resource, as: resource_name, url: registration_path(resource_name), html: { method: :put }) do |f| %>
        <%= render "devise/shared/error_messages", resource: resource %>

        <%# User Info Section %>
        <div style="margin-bottom: 32px;">
          <h3 style="font-size: 16px; font-weight: 600; color: #374151; margin-bottom: 20px; padding-bottom: 12px; border-bottom: 2px solid #f3f4f6;">Βασικές Πληροφορίες</h3>
          
          <% if devise_mapping.confirmable? && resource.pending_reconfirmation? %>
            <div style="background: #fef3c7; border: 1px solid #fbbf24; color: #92400e; padding: 12px 16px; border-radius: 8px; margin-bottom: 20px; font-size: 14px;">
              ⏳ Αναμένεται επιβεβαίωση για: <strong><%= resource.unconfirmed_email %></strong>
            </div>
          <% end %>

          <%# Name Field %>
          <% if resource.respond_to?(:name) %>
            <div style="margin-bottom: 20px;">
              <label style="display: block; font-size: 14px; font-weight: 500; color: #374151; margin-bottom: 8px;">
                Ονοματεπώνυμο
              </label>
              <%= f.text_field :name, autofocus: true,
                  style: "width: 100%; padding: 12px 16px; border: 1px solid #d1d5db; border-radius: 8px; font-size: 14px; outline: none; box-sizing: border-box; transition: all 0.2s;",
                  onfocus: "this.style.borderColor='#6366f1'; this.style.boxShadow='0 0 0 3px rgba(99, 102, 241, 0.1)';",
                  onblur: "this.style.borderColor='#d1d5db'; this.style.boxShadow='none';" %>
            </div>
          <% end %>

          <%# Email Field %>
          <div style="margin-bottom: 20px;">
            <label style="display: block; font-size: 14px; font-weight: 500; color: #374151; margin-bottom: 8px;">
              Email
            </label>
            <%= f.email_field :email, autocomplete: "email",
                style: "width: 100%; padding: 12px 16px; border: 1px solid #d1d5db; border-radius: 8px; font-size: 14px; outline: none; box-sizing: border-box; transition: all 0.2s;",
                onfocus: "this.style.borderColor='#6366f1'; this.style.boxShadow='0 0 0 3px rgba(99, 102, 241, 0.1)';",
                onblur: "this.style.borderColor='#d1d5db'; this.style.boxShadow='none';" %>
          </div>

          <%# Interests & Courses (if they exist) %>
          <% if resource.respond_to?(:interests) %>
            <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 16px;">
              <div>
                <label style="display: block; font-size: 14px; font-weight: 500; color: #374151; margin-bottom: 8px;">
                  Ενδιαφέροντα
                </label>
                <%= f.text_field :interests, placeholder: "π.χ. Java, AI",
                    style: "width: 100%; padding: 12px 16px; border: 1px solid #d1d5db; border-radius: 8px; font-size: 14px; outline: none; box-sizing: border-box; transition: all 0.2s;",
                    onfocus: "this.style.borderColor='#6366f1'; this.style.boxShadow='0 0 0 3px rgba(99, 102, 241, 0.1)';",
                    onblur: "this.style.borderColor='#d1d5db'; this.style.boxShadow='none';" %>
              </div>
              
              <% if resource.respond_to?(:courses) %>
                <div>
                  <label style="display: block; font-size: 14px; font-weight: 500; color: #374151; margin-bottom: 8px;">
                    Μαθήματα
                  </label>
                  <%= f.text_field :courses, placeholder: "π.χ. Ruby on Rails",
                      style: "width: 100%; padding: 12px 16px; border: 1px solid #d1d5db; border-radius: 8px; font-size: 14px; outline: none; box-sizing: border-box; transition: all 0.2s;",
                      onfocus: "this.style.borderColor='#6366f1'; this.style.boxShadow='0 0 0 3px rgba(99, 102, 241, 0.1)';",
                      onblur: "this.style.borderColor='#d1d5db'; this.style.boxShadow='none';" %>
                </div>
              <% end %>
            </div>
          <% end %>
        </div>

        <%# Password Section %>
        <div style="margin-bottom: 32px;">
          <h3 style="font-size: 16px; font-weight: 600; color: #374151; margin-bottom: 20px; padding-bottom: 12px; border-bottom: 2px solid #f3f4f6;">Αλλαγή Κωδικού</h3>
          
          <div style="background: #f8fafc; padding: 20px; border-radius: 8px; margin-bottom: 20px;">
            <p style="color: #6b7280; font-size: 13px; margin: 0 0 16px 0; line-height: 1.5;">
              Αφήστε τα πεδία κωδικού κενά εάν δεν θέλετε να τον αλλάξετε.
            </p>

            <div style="margin-bottom: 20px;">
              <label style="display: block; font-size: 14px; font-weight: 500; color: #374151; margin-bottom: 8px;">
                Νέος Κωδικός
                <% if @minimum_password_length %>
                  <span style="color: #9ca3af; font-weight: 400; font-size: 12px;">
                    (τουλάχιστον <%= @minimum_password_length %> χαρακτήρες)
                  </span>
                <% end %>
              </label>
              <%= f.password_field :password, autocomplete: "new-password", placeholder: "••••••••",
                  style: "width: 100%; padding: 12px 16px; border: 1px solid #d1d5db; border-radius: 8px; font-size: 14px; outline: none; box-sizing: border-box; transition: all 0.2s;",
                  onfocus: "this.style.borderColor='#6366f1'; this.style.boxShadow='0 0 0 3px rgba(99, 102, 241, 0.1)';",
                  onblur: "this.style.borderColor='#d1d5db'; this.style.boxShadow='none';" %>
            </div>

            <div style="margin-bottom: 20px;">
              <label style="display: block; font-size: 14px; font-weight: 500; color: #374151; margin-bottom: 8px;">
                Επιβεβαίωση Νέου Κωδικού
              </label>
              <%= f.password_field :password_confirmation, autocomplete: "new-password", placeholder: "••••••••",
                  style: "width: 100%; padding: 12px 16px; border: 1px solid #d1d5db; border-radius: 8px; font-size: 14px; outline: none; box-sizing: border-box; transition: all 0.2s;",
                  onfocus: "this.style.borderColor='#6366f1'; this.style.boxShadow='0 0 0 3px rgba(99, 102, 241, 0.1)';",
                  onblur: "this.style.borderColor='#d1d5db'; this.style.boxShadow='none';" %>
            </div>

            <div>
              <label style="display: block; font-size: 14px; font-weight: 500; color: #374151; margin-bottom: 8px;">
                Τρέχων Κωδικός
                <span style="color: #ef4444; font-size: 12px; font-weight: 400;">(απαιτείται για επιβεβαίωση)</span>
              </label>
              <%= f.password_field :current_password, autocomplete: "current-password", placeholder: "••••••••",
                  style: "width: 100%; padding: 12px 16px; border: 1px solid #d1d5db; border-radius: 8px; font-size: 14px; outline: none; box-sizing: border-box; transition: all 0.2s;",
                  onfocus: "this.style.borderColor='#6366f1'; this.style.boxShadow='0 0 0 3px rgba(99, 102, 241, 0.1)';",
                  onblur: "this.style.borderColor='#d1d5db'; this.style.boxShadow='none';" %>
            </div>
          </div>
        </div>

        <%# Submit Button %>
        <div style="display: flex; gap: 12px;">
          <%= link_to "Ακύρωση", :back,
              style: "flex: 1; text-align: center; padding: 14px; color: #4b5563; text-decoration: none; border: 1px solid #d1d5db; border-radius: 8px; font-size: 14px; font-weight: 500; transition: all 0.2s;",
              onmouseover: "this.style.backgroundColor='#f3f4f6'; this.style.borderColor='#9ca3af';",
              onmouseout: "this.style.backgroundColor='white'; this.style.borderColor='#d1d5db';" %>
          
          <%= f.submit "Αποθήκευση Αλλαγών",
              style: "flex: 2; padding: 14px; background: linear-gradient(135deg, #6366f1 0%, #8b5cf6 100%); color: white; border: none; border-radius: 8px; font-size: 14px; font-weight: 600; cursor: pointer; transition: all 0.2s;",
              onmouseover: "this.style.opacity='0.9'; this.style.transform='translateY(-1px)';",
              onmouseout: "this.style.opacity='1'; this.style.transform='translateY(0)';" %>
        </div>
      <% end %>
    </div>

    <%# Danger Zone - Account Deletion %>
    <div style="background: white; border-radius: 16px; padding: 40px; border: 1px solid #fecaca; box-shadow: 0 10px 25px -5px rgba(0, 0, 0, 0.05);">
      <div style="display: flex; align-items: center; gap: 12px; margin-bottom: 20px;">
        <div style="width: 40px; height: 40px; background: #fee2e2; border-radius: 10px; display: flex; align-items: center; justify-content: center;">
          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#dc2626" stroke-width="2">
            <circle cx="12" cy="12" r="10"></circle>
            <line x1="12" y1="8" x2="12" y2="12"></line>
            <line x1="12" y1="16" x2="12.01" y2="16"></line>
          </svg>
        </div>
        <div>
          <h3 style="font-size: 18px; font-weight: 700; color: #dc2626; margin: 0;">Επικίνδυνη Ζώνη</h3>
          <p style="color: #6b7280; font-size: 14px; margin: 4px 0 0 0;">Μόνιμες ενέργειες που δεν μπορούν να αναιρεθούν</p>
        </div>
      </div>

      <div style="background: #fef2f2; border-radius: 8px; padding: 20px; border: 1px solid #fecaca;">
        <p style="color: #7f1d1d; font-size: 14px; margin: 0 0 16px 0;">
          Η διαγραφή του λογαριασμού σας είναι μόνιμη και αμετάκλητη. Όλα τα δεδομένα σας θα διαγραφούν οριστικά.
        </p>
        
        <%= button_to "Διαγραφή Λογαριασμού", registration_path(resource_name), 
    method: :delete,
    form: { 
      data: { 
        confirm: "Είστε απόλυτα σίγουρος; Αυτή η ενέργεια δεν μπορεί να αναιρεθεί.",
        turbo_confirm: "Είστε απόλύτα σίγουρος;"
      }
    },
    style: "display: inline-flex; align-items: center; gap: 8px; background: #dc2626; color: white; border: none; padding: 12px 24px; border-radius: 8px; font-size: 14px; font-weight: 500; cursor: pointer; transition: all 0.2s;",
    onmouseover: "this.style.backgroundColor='#b91c1c'; this.style.transform='translateY(-1px)';",
    onmouseout: "this.style.backgroundColor='#dc2626'; this.style.transform='translateY(0)';" %>
      </div>
    </div>
  </div>
</div>