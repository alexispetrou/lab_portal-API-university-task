<div class="chat-container" style="display: flex; height: 500px; border: 1px solid #ddd;">
  
  <div class="chat-sidebar" style="width: 30%; border-right: 1px solid #eee; overflow-y: auto;">
    <% current_user.conversations.each do |conv| %>
      <%# Προσθέτουμε το data-turbo-frame %>
      <%= link_to conversation_path(conv), 
                  style: "text-decoration: none; color: black;", 
                  data: { turbo_frame: "active_chat_window" } do %>
        <div class="chat-option <%= 'active-chat' if conv == @conversation %>" 
             style="padding: 10px; border-bottom: 1px solid #eee; <%= 'background: #f0f7ff;' if conv == @conversation %>">
          <% if conv.post.present? %>
            <strong>📢 <%= conv.post.title %></strong>
          <% else %>
            👤 <%= conv.users.where.not(id: current_user.id).first&.name %>
          <% end %>
        </div>
      <% end %>
    <% end %>
  </div>

  <div class="chat-main" style="width: 70%; display: flex; flex-direction: column;">
    <%= turbo_frame_tag "active_chat_window" do %>
      
      <div id="messages" style="flex-grow: 1; padding: 20px; overflow-y: auto; height: 350px;">
        <% if @messages.any? %>
          <%= render @messages %>
        <% else %>
          <p class="text-center text-muted">Ξεκινήστε τη συνομιλία...</p>
        <% end %>
      </div>

      <div class="chat-input" style="padding: 15px; border-top: 1px solid #eee;">
        <%= render 'messages/form', conversation: @conversation, message: @new_message %>
      </div>

      <script>
        // Αυτόματο scroll τέρμα κάτω στα μηνύματα
        var msgDiv = document.getElementById("messages");
        if (msgDiv) { msgDiv.scrollTop = msgDiv.scrollHeight; }
      </script>

    <% end %>
  </div>
</div>