<% if notice.present? %>
  <div class="fixed top-5 right-5 bg-white border border-gray-200 px-6 py-3 rounded-lg shadow-xl z-50 animate-fade-in-down">
    <span class="text-sm font-medium text-gray-800">● <%= notice %></span>
  </div>
<% end %>

<main class="max-w-2xl mx-auto mt-16 px-6 font-sans antialiased text-gray-900">
  
  <header class="flex justify-between items-center mb-12 border-b border-gray-100 pb-8">
    <div class="space-y-1">
      <h1 class="text-4xl font-extrabold tracking-tight text-gray-900">Posts</h1>
    </div>
    
    <%= link_to new_post_path, class: "inline-flex items-center gap-2 bg-gray-900 hover:bg-blue-600 text-white px-8 py-4 rounded-full text-base font-semibold transition-all duration-200 shadow-sm hover:shadow-md hover:-translate-y-0.5" do %>
      <svg xmlns="http://www.w3.org/2000/svg" width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
        <line x1="12" y1="5" x2="12" y2="19"></line>
        <line x1="5" y1="12" x2="19" y2="12"></line>
      </svg>
      <span>New entry</span>
    <% end %>
  </header>

  <section id="posts" class="space-y-16">
    <% @posts.each do |post| %>
      <article class="group">
        <div class="mb-4">
          <%= render post %>
        </div>
        
        
      </article>
    <% end %>
  </section>

  <% if @posts.none? %>
    <div class="mt-20 text-center italic text-gray-400">
      The list is currently empty.
    </div>
  <% end %>

</main>