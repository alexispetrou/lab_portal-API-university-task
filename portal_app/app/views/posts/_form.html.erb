<%= form_with(model: post) do |form| %>
  <% if post.errors.any? %>
    <div style="background-color: #fef2f2; border: 1px solid #fecaca; padding: 16px; border-radius: 8px; margin-bottom: 24px;">
      <h2 style="color: #991b1b; font-size: 14px; font-weight: 600; margin: 0 0 8px 0;">
        <%= pluralize(post.errors.count, "λάθος") %> εμπόδισαν την αποθήκευση:
      </h2>
      <ul style="margin: 0; padding-left: 20px; color: #b91c1c; font-size: 13px;">
        <% post.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div style="margin-bottom: 20px;">
    <%= form.label :title, "Τίτλος Ανάρτησης", style: "display: block; font-size: 14px; font-weight: 500; color: #374151; margin-bottom: 6px;" %>
    <%= form.text_field :title, placeholder: "π.χ. Αναζήτηση ομάδας για την εργασία Rails", 
        style: "width: 100%; padding: 12px; border: 1px solid #d1d5db; border-radius: 8px; font-size: 14px; outline: none; box-sizing: border-box;" %>
  </div>

  <div style="margin-bottom: 20px;">
    <%= form.label :category, "Κατηγορία (Μάθημα)", style: "display: block; font-size: 14px; font-weight: 500; color: #374151; margin-bottom: 6px;" %>
    <%= form.text_field :category, placeholder: "π.χ. Υπηρεσιοστρεφές Λογισμικό", 
        style: "width: 100%; padding: 12px; border: 1px solid #d1d5db; border-radius: 8px; font-size: 14px; outline: none; box-sizing: border-box;" %>
  </div>

  <div style="margin-bottom: 20px;">
    <%= form.label :content, "Περιεχόμενο", style: "display: block; font-size: 14px; font-weight: 500; color: #374151; margin-bottom: 6px;" %>
    <%= form.text_area :content, rows: 5, placeholder: "Περιγράψτε τι ψάχνετε...", 
        style: "width: 100%; padding: 12px; border: 1px solid #d1d5db; border-radius: 8px; font-size: 14px; outline: none; box-sizing: border-box; resize: vertical;" %>
  </div>

  <%# Κρυφό πεδίο για το user_id - δεν θέλουμε ο χρήστης να το βλέπει ή να το αλλάζει %>
  <%= form.hidden_field :user_id, value: current_user.id %>

  <div style="margin-top: 32px;">
    <%= form.submit "Δημοσίευση Ανάρτησης", 
        style: "width: 100%; padding: 14px; background-color: #111827; color: white; border: none; border-radius: 8px; font-size: 15px; font-weight: 600; cursor: pointer; transition: background-color 0.2s;" %>
  </div>
<% end %>